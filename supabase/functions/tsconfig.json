{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "paths": {
      "std/*": ["https://deno.land/std@0.190.0/*"]
    }
  },
  "include": ["**/*.ts"]
}

